; I2C v1.1 - listing (addresses relative to IC = RAM+&400), 252 bytes
;
                    ; =====================================================================
                    ; I2C v1.1 - software I2C master for the Sharp PC-1500(A), faster version
                    ; SCL = PC7 (pin 10, &F008 bit 7), SDA = PB2 (CMT-IN, pin 27) or PB0
                    ; (pin 9) - chosen in the installer. CPU LH5801 @ 1.3 MHz.
                    ;
                    ; Call, parameters, results and memory unchanged from v1.0:
                    ;   POKE IA, D, W, R : CALL IC   or   CALL IC,E   (E = result)
                    ;   IC = RAM+&400, IA = RAM+&4FC (D, W, R), IS = RAM+&4FF (result),
                    ;   TX = RAM+&300, RX = RAM+&200.
                    ;   Result: 0 = OK, 1 = no ACK after the address, 2 = no ACK after a data
                    ;   byte, 3 = SDA stays low (transaction not started).
                    ;
                    ; What makes v1.1 faster (times from the MAME cycle table):
                    ; 1. A 0 bit when sending is the single instruction ORI #(X),BM (SDA =
                    ;    output), without clearing the OPB latch and without SJP/RTN. The SDA
                    ;    latch is always 0 when SEND starts a byte: after START, SDA0 clears
                    ;    it, and after a data byte the ACK read (SDA = 0) writes 0 into the
                    ;    latch in the MAME model; in the model of a real latch the 0 stays
                    ;    from SDA0. After a NACK comes STOP, which clears the latch itself.
                    ; 2. The send loop has two states: H (SDA = 1) and L (SDA = 0). SDA only
                    ;    changes when a bit differs from the previous one, and a byte that
                    ;    ends with a 1 bit no longer has to release SDA before the ACK.
                    ; 3. Receiving: X points to OPB (&F00F), so reading SDA is BII #(X),BM
                    ;    (14 cycles instead of 20). A 0 bit needs no REC: C = 0 inside the
                    ;    loop, because the sentinel only leaves into C after the 8th bit.
                    ;    The receiver ACK uses the absolute address &F00D, without switching X.
                    ; 4. One routine ADDR sends the address (for write and read) and runs
                    ;    straight into SEND. START contains the SDA0 code (without SJP/RTN),
                    ;    and STOP calls SDA0 inside START.
                    ; After the read address there is a deliberate delay, so that the device
                    ; (e.g. an Arduino) has time to prepare its data - SCL stays low for
                    ; about 70 us, as in v1.0.
                    ;
                    ; Lines (as in v1.0):
                    ;   SCL: port C has outputs only, PC7 drives SCL push-pull, no
                    ;        "clock stretching".
                    ;   SDA: open drain emulated with the direction register DDB (&F00D):
                    ;        SDA = 1: DDB bit = 0 (input), the resistor makes the high level;
                    ;        SDA = 0: DDB bit = 1 (output) with output latch OPB = 0.
                    ; Every line change is a separate ORI/ANI instruction (>= 17 cycles =
                    ; 13 us), so the minimum I2C times (4.7 us) hold without delay loops.
                    ;
                    ; Registers: X = &F00D (DDB), while receiving &F00F (OPB); Y = &F008
                    ; (port C); U = buffer pointer; A = data. Bit counter: a sentinel bit.
                    ; Z after SHL is tested with BII A,&FF, because according to the LH5801
                    ; manual the shift instructions do not set the Z flag.
                    ;
                    ; Load address: IC = RAM+&400 (&4400 on a PC-1500A), followed by the
                    ; parameters D, W, R and the result (IA = RAM+&4FC .. IS = RAM+&4FF).
                    ; Symbols filled in by BASIC: IP = page of the code (SJP addresses and
                    ; parameters), TP/RP = pages of the TX/RX buffers, BM = bit mask of SDA
                    ; in port B (4 = PB2, 1 = PB0), DB = 255-BM.
                    ; =====================================================================
00  FD BE                   RIE                     ; no interrupts
02  48 F0                   LDI  XH,&F0
04  4A 0D                   LDI  XL,&0D             ; X = &F00D (DDB: direction of SDA)
06  58 F0                   LDI  YH,&F0
08  5A 08                   LDI  YL,&08             ; Y = &F008 (port C: SCL = PC7)
0A  FD 49 DB                ANI  #(X),DB            ; SDA = 1 (released)
0D  FD 5B 80                ORI  #(Y),&80           ; SCL = 1
10  6A 09                   LDI  UL,9               ; SDA = 0: up to 10 SCL pulses
12  FD ED F0 0F BM  BUSY:   BII  #(&F00F),BM        ; SDA = 1 -> bus free
17  89 0C                   BZR+ FREE
19  FD 59 7F                ANI  #(Y),&7F           ; SCL pulse: a device that holds
1C  FD 5B 80                ORI  #(Y),&80           ; SDA sends its next bit
1F  88 0F                   LOP  UL,BUSY
21  B5 03                   LDI  A,3                ; SDA still 0: result 3, no START/STOP
23  8E 7A                   BCH+ EXIT
25  A5 IP FD        FREE:   LDA  (IP,&FD)           ; W
28  89 05                   BZR+ WR
2A  A5 IP FE                LDA  (IP,&FE)           ; R
2D  89 1D                   BZR+ RD                 ; W = 0, R > 0: read at once
2F  F9              WR:     REC                     ; C = 0: address for writing
30  BE IP B9                SJP  ADDR
33  83 5B                   BCS+ NAKA
35  68 TP                   LDI  UH,TP
37  6A 00                   LDI  UL,0               ; U = TX
39  24              WNEXT:  LDA  UL
3A  A7 IP FD                CPA  (IP,&FD)           ; W bytes sent?
3D  8B 08                   BZS+ WEND
3F  65                      LIN  U                  ; A = byte, U++
40  BE IP C3                SJP  SEND
43  83 4F                   BCS+ NAKD
45  9E 0E                   BCH- WNEXT
47  A5 IP FE        WEND:   LDA  (IP,&FE)           ; R
4A  8B 40                   BZS+ OK
4C  FB              RD:     SEC                     ; C = 1: address for reading
4D  BE IP B9                SJP  ADDR
50  83 3E                   BCS+ NAKA
52  BE IP FB                SJP  SRET               ; 30 cycles for the device to prepare its data
55  68 RP                   LDI  UH,RP
57  6A 00                   LDI  UL,0               ; U = RX
59  4A 0F                   LDI  XL,&0F             ; X = &F00F (OPB: read SDA), C = 0
5B  B5 01           RBYTE:  LDI  A,1                ; sentinel: leaves into C after 8 bits
5D  FD 5B 80        RBIT:   ORI  #(Y),&80           ; SCL = 1
60  FD 4D BM                BII  #(X),BM            ; read SDA
63  8B 01                   BZS+ R0
65  FB                      SEC                     ; bit 1 (C = 0 in the loop, so bit 0 needs no REC)
66  DB              R0:     ROL                     ; A = A*2 + bit
67  FD 59 7F                ANI  #(Y),&7F           ; SCL = 0
6A  91 0F                   BCR- RBIT               ; C = 1: the sentinel left, byte complete
6C  61                      SIN  U                  ; store, U++
6D  24                      LDA  UL
6E  A7 IP FE                CPA  (IP,&FE)           ; C = 1: this was the last (R-th) byte
71  83 08                   BCS+ R9                 ; last one: NACK (SDA = 1)
73  FD EB F0 0D BM          ORI  #(&F00D),BM        ; ACK: SDA = output ...
78  FD 49 DB                ANI  #(X),DB            ; ... latch OPB = 0
7B  FD 5B 80        R9:     ORI  #(Y),&80           ; 9th SCL pulse (ACK or NACK)
7E  FD 59 7F                ANI  #(Y),&7F           ; (ORI/ANI do not change C)
81  83 07                   BCS+ RDONE
83  FD E9 F0 0D DB          ANI  #(&F00D),DB        ; release SDA; C = 0
88  9E 2F                   BCH- RBYTE
8A  4A 0D           RDONE:  LDI  XL,&0D             ; X = DDB
8C  B5 00           OK:     LDI  A,0
8E  8E 06                   BCH+ STOP
90  B5 01           NAKA:   LDI  A,1
92  8E 02                   BCH+ STOP
94  B5 02           NAKD:   LDI  A,2
96  BE IP AD        STOP:   SJP  SDA0               ; SDA = 0 while SCL = 0
99  FD 5B 80                ORI  #(Y),&80           ; SCL = 1
9C  FD 49 DB                ANI  #(X),DB            ; SDA 0 -> 1 while SCL = 1: STOP
9F  AE IP FF        EXIT:   STA  (IP,&FF)           ; IS = result
A2  0A                      STA  XL
A3  48 00                   LDI  XH,0               ; X = result ...
A5  FB                      SEC                     ; ... C=1: BASIC copies X into E of CALL IC,E
A6  9A                      RTN
                    ;
                    ; START: SDA 1 -> 0 while SCL = 1, then SCL = 0 (A and C unchanged).
                    ; SDA0 (entry from STOP while SCL = 0): SDA = 0 (output, latch 0), and
                    ; the second SCL = 0 then changes nothing.
A7  FD 49 DB        START:  ANI  #(X),DB            ; SDA = 1
AA  FD 5B 80                ORI  #(Y),&80           ; SCL = 1
AD  FD 4B BM        SDA0:   ORI  #(X),BM            ; SDA = output ...
B0  FD E9 F0 0F DB          ANI  #(&F00F),DB        ; ... latch OPB = 0: SDA 1 -> 0 (START)
B5  FD 59 7F                ANI  #(Y),&7F           ; SCL = 0
B8  9A                      RTN
                    ;
                    ; ADDR: START (or repeated START), then the byte D*2+C through SEND. After
                    ; START, ADDR releases SDA (allowed while SCL = 0), so SEND starts in state H.
B9  BE IP A7        ADDR:   SJP  START
BC  A5 IP FC                LDA  (IP,&FC)           ; D
BF  DB                      ROL                     ; D*2 + C (0 write, 1 read)
C0  FD 49 DB                ANI  #(X),DB            ; SDA = 1
                    ; SEND: send A (most significant bit first); C = 0 ACK, C = 1 no ACK.
                    ; Entry with SDA released (after the ACK of the previous byte): state H.
                    ; The loop has two states: H (SDA = 1) and L (SDA = 0); only a bit that
                    ; differs from the previous one changes SDA. On entry the SDA latch = 0
                    ; (see above), so SDA = 0 just means SDA = output.
C3  FB              SEND:   SEC
C4  DB                      ROL                     ; C = bit 7, sentinel 1 -> bit 0
C5  81 0D           HB:     BCR+ HL                 ; state H, bit 0: SDA = 0
C7  FD 5B 80        HC:     ORI  #(Y),&80           ; SCL pulse
CA  FD 59 7F                ANI  #(Y),&7F
CD  D9                      SHL                     ; C = next bit
CE  BF FF                   BII  A,&FF              ; A = 0 -> 8 bits sent
D0  99 0D                   BZR- HB
D2  8E 18                   BCH+ SACKH              ; SDA already released
D4  FD 4B BM        HL:     ORI  #(X),BM            ; SDA = 0 -> state L
D7  FD 5B 80        LC:     ORI  #(Y),&80           ; SCL pulse
DA  FD 59 7F                ANI  #(Y),&7F
DD  D9                      SHL
DE  BF FF                   BII  A,&FF
E0  8B 07                   BZS+ SACKL
E2  91 0D           LB:     BCR- LC                 ; state L, bit 0: SDA unchanged
E4  FD 49 DB                ANI  #(X),DB            ; bit 1: SDA = 1 -> state H
E7  9E 22                   BCH- HC
E9  FD 49 DB        SACKL:  ANI  #(X),DB            ; release SDA: the device sends the ACK
EC  FD 5B 80        SACKH:  ORI  #(Y),&80           ; 9th SCL pulse
EF  FB                      SEC                     ; C = 1: no ACK ...
F0  FD ED F0 0F BM          BII  #(&F00F),BM        ; (reading ACK = 0 clears the latch in the MAME model)
F5  89 01                   BZR+ SNAK
F7  F9                      REC                     ; ... SDA = 0: ACK, C = 0
F8  FD 59 7F        SNAK:   ANI  #(Y),&7F           ; SCL = 0
FB  9A              SRET:   RTN
