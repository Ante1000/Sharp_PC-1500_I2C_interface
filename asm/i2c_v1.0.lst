; I2C v1.0 - listing (addresses relative to IC = RAM+&400), 241 bytes
;
                    ; =====================================================================
                    ; I2C v1.0 - software I2C master for the Sharp PC-1500(A)
                    ; SCL = PC7 (pin 10, &F008 bit 7), SDA = PB2 (CMT-IN, pin 27) or PB0
                    ; (pin 9) - chosen in the installer. CPU LH5801 @ 1.3 MHz.
                    ;
                    ; Call from BASIC (IA = RAM+&4FC, IS = RAM+&4FF, IC = RAM+&400):
                    ;   POKE IA, D, W, R     D = device address (7 bits, 0..127)
                    ;                        W = number of bytes to send from TX (0..255)
                    ;                        R = number of bytes to receive into RX (0..255)
                    ;   CALL IC              or   CALL IC,E   (E = result)
                    ; Transaction:
                    ;   W>0 or R=0:    START, D*2+0 (write), bytes TX+0 .. TX+W-1
                    ;   R>0:           (repeated) START, D*2+1 (read), bytes into RX+0 ..
                    ;                  RX+R-1 (ACK after each byte, NACK after the last one)
                    ;   STOP at the end. W=0 and R=0: address only - presence test (scanner).
                    ; Result (byte IS, and with CALL IC,E also the variable E; returns with C=1):
                    ;   0 = OK
                    ;   1 = no ACK after the address (no device at this address)
                    ;   2 = no ACK after a data byte (the device refused the write)
                    ;   3 = SDA stays low (bus blocked; 10 SCL pulses did not release it),
                    ;       the transaction was not started
                    ; Buffers as in SERIN/SEROUT v6.x: TX = RAM+&300, RX = RAM+&200, each
                    ; at the start of a memory page, so the byte counter = low byte of the address.
                    ;
                    ; Lines:
                    ;   SCL: port C has outputs only, so PC7 drives SCL push-pull:
                    ;        no "clock stretching" (the device cannot hold the clock).
                    ;   SDA: open drain emulated with the direction register DDB (&F00D):
                    ;        SDA = 1: DDB bit = 0 (input), the resistor makes the high level
                    ;        SDA = 0: DDB bit = 1 (output) and output latch OPB (&F00F) = 0.
                    ;        The latch is cleared after every switch to output, because in
                    ;        the LH5811 model of MAME a write to an input bit does not reach
                    ;        the latch, and a read of the port writes the pin state into it.
                    ; SCL clock: about 10 kHz (a byte takes about 1 ms). Every line change is
                    ; a separate ORI/ANI instruction (>= 17 cycles = 13 us), so the minimum
                    ; I2C times (4.7 us) always hold without delay loops; I2C has no lower
                    ; limit for the clock frequency.
                    ;
                    ; Registers: X = &F00D (DDB), Y = &F008 (port C), U = buffer pointer,
                    ; A = data. Bit counters without a register: a sentinel bit as in SEROUT.
                    ; Z after SHL is tested with BII A,&FF, because according to the LH5801
                    ; manual the shift instructions do not set the Z flag.
                    ;
                    ; Load address: IC = RAM+&400 (&4400 on a PC-1500A), 241 bytes, followed
                    ; by the parameters D, W, R and the result (IA = RAM+&4FC .. IS = RAM+&4FF).
                    ; Symbols filled in by BASIC: IP = page of the code (SJP addresses and
                    ; parameters), TP/RP = pages of the TX/RX buffers, BM = bit mask of SDA
                    ; in port B (4 = PB2, 1 = PB0), DB = 255-BM.
                    ; =====================================================================
00  FD BE                   RIE                     ; no interrupts
02  48 F0                   LDI  XH,&F0
04  4A 0D                   LDI  XL,&0D             ; X = &F00D (DDB: direction of SDA)
06  58 F0                   LDI  YH,&F0
08  5A 08                   LDI  YL,&08             ; Y = &F008 (port C: SCL = PC7)
0A  FD 49 DB                ANI  #(X),DB            ; SDA = 1 (released)
0D  FD 5B 80                ORI  #(Y),&80           ; SCL = 1
10  6A 09                   LDI  UL,9               ; SDA = 0: up to 10 SCL pulses
12  FD ED F0 0F BM  BUSY:   BII  #(&F00F),BM        ; SDA = 1 -> bus free
17  89 0C                   BZR+ FREE
19  FD 59 7F                ANI  #(Y),&7F           ; SCL pulse: a device that holds
1C  FD 5B 80                ORI  #(Y),&80           ; SDA sends its next bit
1F  88 0F                   LOP  UL,BUSY
21  B5 03                   LDI  A,3                ; SDA still 0: result 3, no START/STOP
23  8E 6C                   BCH+ EXIT
25  A5 IP FD        FREE:   LDA  (IP,&FD)           ; W
28  89 05                   BZR+ WR
2A  A5 IP FE                LDA  (IP,&FE)           ; R
2D  89 23                   BZR+ RD                 ; W = 0, R > 0: read at once
2F  BE IP 99        WR:     SJP  START
32  A5 IP FC                LDA  (IP,&FC)           ; D
35  D9                      SHL                     ; D*2+0: write
36  BE IP AF                SJP  SEND
39  83 47                   BCS+ NAKA
3B  68 TP                   LDI  UH,TP
3D  6A 00                   LDI  UL,0               ; U = TX
3F  24              WNEXT:  LDA  UL
40  A7 IP FD                CPA  (IP,&FD)           ; W bytes sent?
43  8B 08                   BZS+ WEND
45  65                      LIN  U                  ; A = byte, U++
46  BE IP AF                SJP  SEND
49  83 3B                   BCS+ NAKD
4B  9E 0E                   BCH- WNEXT
4D  A5 IP FE        WEND:   LDA  (IP,&FE)           ; R
50  8B 2C                   BZS+ OK
52  BE IP 99        RD:     SJP  START              ; START or repeated START
55  A5 IP FC                LDA  (IP,&FC)
58  FB                      SEC
59  DB                      ROL                     ; D*2+1: read
5A  BE IP AF                SJP  SEND
5D  83 23                   BCS+ NAKA
5F  68 RP                   LDI  UH,RP
61  6A 00                   LDI  UL,0               ; U = RX
63  BE IP D9        RNEXT:  SJP  RECV               ; A = byte, SCL = 0
66  61                      SIN  U                  ; store, U++
67  24                      LDA  UL
68  A7 IP FE                CPA  (IP,&FE)           ; R bytes received?
6B  8B 0B                   BZS+ RLAST
6D  BE IP A6                SJP  SDA0               ; ACK: SDA = 0 ...
70  FD 5B 80                ORI  #(Y),&80           ; ... during the 9th SCL pulse
73  FD 59 7F                ANI  #(Y),&7F
76  9E 15                   BCH- RNEXT              ; RECV releases SDA
78  FD 5B 80        RLAST:  ORI  #(Y),&80           ; NACK (SDA = 1) during the 9th SCL pulse
7B  FD 59 7F                ANI  #(Y),&7F
7E  B5 00           OK:     LDI  A,0
80  8E 06                   BCH+ STOP
82  B5 01           NAKA:   LDI  A,1
84  8E 02                   BCH+ STOP
86  B5 02           NAKD:   LDI  A,2
88  BE IP A6        STOP:   SJP  SDA0               ; SDA = 0 while SCL = 0
8B  FD 5B 80                ORI  #(Y),&80           ; SCL = 1
8E  FD 49 DB                ANI  #(X),DB            ; SDA 0 -> 1 while SCL = 1: STOP
91  AE IP FF        EXIT:   STA  (IP,&FF)           ; IS = result
94  0A                      STA  XL
95  48 00                   LDI  XH,0               ; X = result ...
97  FB                      SEC                     ; ... C=1: BASIC copies X into E of CALL IC,E
98  9A                      RTN
                    ;
                    ; START: SDA 1 -> 0 while SCL = 1, then SCL = 0
99  FD 49 DB        START:  ANI  #(X),DB            ; SDA = 1
9C  FD 5B 80                ORI  #(Y),&80           ; SCL = 1
9F  BE IP A6                SJP  SDA0               ; SDA 1 -> 0 while SCL = 1: START
A2  FD 59 7F                ANI  #(Y),&7F           ; SCL = 0
A5  9A                      RTN
                    ;
                    ; SDA0: SDA = 0 (output, latch 0); A and the C flag unchanged
A6  FD 4B BM        SDA0:   ORI  #(X),BM            ; SDA = output ...
A9  FD E9 F0 0F DB          ANI  #(&F00F),DB        ; ... latch OPB = 0
AE  9A                      RTN
                    ;
                    ; SEND: send A (most significant bit first); C = 0 ACK, C = 1 no ACK
AF  FB              SEND:   SEC
B0  DB                      ROL                     ; C = bit 7, sentinel 1 -> bit 0
B1  83 05           SBIT:   BCS+ SONE
B3  BE IP A6                SJP  SDA0               ; bit 0: SDA = 0
B6  8E 03                   BCH+ SCLK
B8  FD 49 DB        SONE:   ANI  #(X),DB            ; bit 1: SDA = 1
BB  FD 5B 80        SCLK:   ORI  #(Y),&80           ; SCL pulse
BE  FD 59 7F                ANI  #(Y),&7F
C1  D9                      SHL                     ; C = next bit
C2  BF FF                   BII  A,&FF              ; A = 0 -> 8 bits sent
C4  99 15                   BZR- SBIT
C6  FD 49 DB                ANI  #(X),DB            ; release SDA: the device sends the ACK
C9  FD 5B 80                ORI  #(Y),&80           ; 9th SCL pulse
CC  FB                      SEC                     ; C = 1: no ACK ...
CD  FD ED F0 0F BM          BII  #(&F00F),BM
D2  89 01                   BZR+ SNAK
D4  F9                      REC                     ; ... SDA = 0: ACK, C = 0
D5  FD 59 7F        SNAK:   ANI  #(Y),&7F           ; SCL = 0
D8  9A                      RTN
                    ;
                    ; RECV: receive a byte into A (most significant bit first), ends with SCL = 0
D9  FD 49 DB        RECV:   ANI  #(X),DB            ; SDA = 1: the device sends
DC  B5 01                   LDI  A,1                ; sentinel: leaves into C after 8 bits
DE  FD 5B 80        RBIT:   ORI  #(Y),&80           ; SCL = 1
E1  FB                      SEC
E2  FD ED F0 0F BM          BII  #(&F00F),BM        ; read SDA
E7  89 01                   BZR+ RONE
E9  F9                      REC
EA  DB              RONE:   ROL                     ; A = A*2 + bit
EB  FD 59 7F                ANI  #(Y),&7F           ; SCL = 0
EE  91 12                   BCR- RBIT
F0  9A                      RTN
